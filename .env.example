# ---- Suraksha environment template ----
# Copy to .env and change every secret before any real deployment.

NODE_ENV=development
PORT=4000

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# Leave empty to use the embedded PostgreSQL engine (PGlite) stored in ./data.
# For production set a real PostgreSQL connection string, e.g.:
# DATABASE_URL=postgres://suraksha:suraksha@localhost:5432/suraksha
DATABASE_URL=

# Comma separated allowed browser origins. Same-origin production use can leave this.
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Seed a demo family + demo data on boot (never enable in production).
DEMO_MODE=1

# Public base URL used in QR pairing payloads
PUBLIC_BASE_URL=http://localhost:4000

# Optional TURN relay for WebRTC across restrictive/carrier networks.
# Local dev works with public STUN only; production should run coturn.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Push notifications: add a Firebase service account JSON path to enable FCM.
# Without it the server uses authenticated WebSocket + in-app notifications.
FCM_SERVICE_ACCOUNT_JSON=

# Data retention defaults (days)
LOCATION_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=180
